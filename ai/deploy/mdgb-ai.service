# systemd unit for the vision process on the Arduino UNO Q (Linux side).
# Install: ai/deploy/push_to_arduino.sh <user@board> --service   (it fills in the home folder and MDGB_C3_DIR)
# If this process stops, the heartbeat stops and the firmware falls back by itself within 500 ms;
# systemd then starts it again.
[Unit]
Description=MDGB smartcrossing (vision and rules)
After=network.target

[Service]
User=arduino
WorkingDirectory=/home/arduino/HackTurin-mdgb/ai
# Folder of the events (C3). With the App Lab app of the sketch: /home/arduino/ArduinoApps/<app>/data/c3
Environment=MDGB_C3_DIR=/home/arduino/HackTurin-mdgb/logs/c3
# libcamerify: the camera of the board is a CSI sensor read by libcamera; this makes OpenCV see it as /dev/video0.
ExecStart=/usr/bin/libcamerify /home/arduino/venv/bin/python -m smartcrossing.app --source 0 --profile unoq --headless --actuator bridge --operator-port 8090
Restart=always
RestartSec=2
# Stop like Ctrl+C: the vision closes the camera and the link cleanly. A camera left half open (SIGKILL) can stay
# locked in the driver until the board is restarted.
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
