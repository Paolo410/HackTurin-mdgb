# Copia in app/.env (ignorato da git) e compila. Certificati in certs/ nella root del repo (ignorata da git).
# Centrale su AWS IoT Core (Thing "mdgb-ingest", creato con comms/aws/setup_thing.sh):
MQTT_HOST=xxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com   # stampato da setup_thing.sh
MQTT_PORT=8883
MQTT_TLS=1
MQTT_CA=certs/AmazonRootCA1.pem
MQTT_CERT=certs/mdgb-ingest.cert.pem
MQTT_KEY=certs/mdgb-ingest.private.key
INGEST_CLIENT_ID=mdgb-ingest
# Riserva senza AWS (Mosquitto sul PC): MQTT_HOST=localhost, MQTT_PORT=1883, MQTT_TLS=0
