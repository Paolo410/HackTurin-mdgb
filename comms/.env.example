# Configurazione del nodo sull'Arduino UNO Q. Copia in comms/.env (ignorato da git): config.py lo legge da solo.
NODE_ID=nodo01                      # nome del nodo: deve coincidere con una camera di app/nodes.json sul PC

# --- Demo (modalità locale): il broker è dentro l'app "MDGB Centrale" sul PC.
#     MQTT_HOST = indirizzo che l'app mostra in alto ("Arduino → 192.168.x.y:1883"). PC e Arduino sulla stessa rete Wi-Fi.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_TLS=0

# --- Produzione (in futuro): AWS IoT Core o un altro broker MQTT 5 con TLS e un certificato per nodo.
#     Stesso codice, cambiano solo queste righe (certificati in certs/ nella root del repo, vedi comms/aws/).
# MQTT_HOST=xxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com
# MQTT_PORT=8883
# MQTT_TLS=1
# MQTT_CA=certs/AmazonRootCA1.pem
# MQTT_CERT=certs/nodo01.cert.pem
# MQTT_KEY=certs/nodo01.private.key

BACKUP_LINK=ble                     # ble (demo) | lora (produzione) | none
BACKUP_HB_S=30                      # heartbeat sul BLE ogni 30 s nella demo (300 = 5 min in produzione)
EVENT_SOURCE=c3                     # c3 = eventi dai file di ai/ (logs/c3) | sim = simulatore interno
AGG_PERIOD_S=60                     # aggregati ogni 60 s nella demo (900 = 15 min in produzione)
