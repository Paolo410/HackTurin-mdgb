# Copia in .env (ignorato da git) e compila. I certificati stanno in certs/ (ignorata da git).
NODE_ID=nodo01                      # = nome del Thing AWS IoT
TOPIC_PREFIX=mdgb
MQTT_HOST=xxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com   # stampato da comms/aws/setup_thing.sh
MQTT_PORT=8883                      # 443 se la rete blocca la 8883 (ALPN x-amzn-mqtt-ca)
MQTT_TLS=1
MQTT_CA=certs/AmazonRootCA1.pem
MQTT_CERT=certs/nodo01.cert.pem
MQTT_KEY=certs/nodo01.private.key
BACKUP_LINK=ble                     # ble (demo) | lora (produzione) | none
EVENT_SOURCE=c3                     # c3 (file di ai/) | sim (simulatore)
AGG_PERIOD_S=60                     # 900 in produzione
